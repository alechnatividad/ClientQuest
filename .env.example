# ClientQuest — Supabase connection
# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API Keys). Never commit .env.local.
#
# The publishable key (sb_publishable_...) is safe for the browser. Never add
# a secret/service-role key to frontend environment variables.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
